GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Discovery and ranking run only when requested from the dashboard.
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_MINUTES=360
AUTO_DISCOVERY_LIMIT=60
AUTO_SCAN_LIMIT=30
AUTO_MINIMUM_SCORE=65
DAILY_SCAN_LIMIT=30
JOB_AGENT_TIMEZONE=Asia/Kolkata

# Optional one-way Google Sheets tracker sync.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_TAB=Applications
